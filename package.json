{
  "name": "attendance-management",
  "version": "1.0.0",
  "private": true,
  "description": "Geofenced office attendance manager: GPS check-in/out PWA, lateness and absence tracking, leave approvals and Excel reports",
  "scripts": {
    "start": "npm start --prefix server",
    "dev": "npm run dev --prefix server",
    "seed": "npm run seed --prefix server",
