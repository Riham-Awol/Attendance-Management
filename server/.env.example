# ── Required ─────────────────────────────────────────────────────────────
# Where MongoDB lives. Local install, Docker, or a free MongoDB Atlas cluster.
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=office_attendance

# Sign your login tokens. MUST be a long random string in production —
# the server refuses to start with a short one when NODE_ENV=production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ── Office ───────────────────────────────────────────────────────────────
# Every date, shift time and report is calculated in this timezone.
# Use an IANA name: Africa/Addis_Ababa, Europe/London, Asia/Dubai, America/New_York…
DEFAULT_TIMEZONE=Africa/Addis_Ababa
PORT=4000

# ── First admin ──────────────────────────────────────────────────────────
# Created automatically on first start if no admin exists yet.
# You will be asked to change this password the first time you sign in.
ADMIN_NAME=System Admin
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=ChangeMe123!

# ── Background jobs ──────────────────────────────────────────────────────
CRON_ENABLED=true
# Only needed on a serverless host (Vercel), where the jobs are triggered by
# scheduled HTTP calls instead of an in-process timer. The endpoints refuse to
# run without it. Generate one the same way as JWT_SECRET.
#CRON_SECRET=another-long-random-string
# How long after a shift ends before an open check-in is closed automatically.
AUTO_CHECKOUT_GRACE_MINUTES=120

# ── Email alerts (optional) ──────────────────────────────────────────────
# Leave SMTP_HOST blank and alerts are logged instead of sent, which is fine
# while you are trying the app out.
# For Gmail use an App Password, not your normal password.
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=you@yourcompany.com
#SMTP_PASS=your-app-password
#MAIL_FROM=Attendance <no-reply@yourcompany.com>

# ── Hosting the PWA elsewhere (optional) ─────────────────────────────────
# By default the server serves the app itself and no CORS is needed.
#CORS_ORIGINS=https://attendance.yourcompany.com
